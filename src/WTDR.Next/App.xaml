<Application x:Class="WTDR.Next.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#F5F7FB" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelLightBrush" Color="#E9EEF7" />
    <SolidColorBrush x:Key="TextBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="MutedBrush" Color="#667085" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="FontFamily" Value="Segoe UI Variable" /></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Background" Value="{StaticResource PanelLightBrush}" /><Setter Property="Padding" Value="14,9" /><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="CornerRadius" Value="8" /><Setter Property="FontFamily" Value="Segoe UI Variable" /></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="4" /><Setter Property="Margin" Value="0,2" /></Style>
  </Application.Resources>
</Application>
