<Window x:Class="WTDR.Next.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="24" Background="{StaticResource WindowBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Grid.Column="0" Grid.RowSpan="3" Width="174" Margin="0,4,0,0">
        <Border Width="42" Height="42" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" CornerRadius="12" Margin="0,2,0,14">
          <TextBlock Text="W" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="WTDR.Next" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,3"/>
        <TextBlock Text="Windows 部署控制台" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,30"/>
        <TextBlock Text="工作区" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,0,0,8"/>
        <Button Width="174" HorizontalAlignment="Left" Content="概览" HorizontalContentAlignment="Left" Background="{StaticResource AccentBrush}"/>
        <Button Width="174" HorizontalAlignment="Left" Content="软件包" HorizontalContentAlignment="Left" Click="Packages_Click"/>
        <Button Width="174" HorizontalAlignment="Left" Content="任务日志" HorizontalContentAlignment="Left" Click="Logs_Click"/>
        <Button Width="174" HorizontalAlignment="Left" Content="设置" HorizontalContentAlignment="Left" Click="Settings_Click"/>
        <Border Background="#EEF2F8" CornerRadius="12" Padding="14" Margin="0,36,0,0">
          <StackPanel><TextBlock Text="运行环境" FontWeight="SemiBold"/><TextBlock x:Name="EnvironmentText" Text="检测中..." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"/></StackPanel>
        </Border>
    </StackPanel>
    <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="打开软件包目录" Click="OpenFolder_Click"/><Button Content="刷新" Click="Refresh_Click"/>
    </StackPanel>
    <ScrollViewer Grid.Column="2" Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="控制台" FontSize="32" FontWeight="SemiBold"/>
        <TextBlock Text="安全、可追踪地执行你的 Windows 部署任务" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,26" FontSize="14"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="22"><StackPanel><TextBlock Text="软件包" Foreground="{StaticResource MutedBrush}" FontSize="13"/><TextBlock x:Name="PackageCountText" Text="0" FontSize="38" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="可用 Pack" Foreground="{StaticResource MutedBrush}" FontSize="12"/></StackPanel></Border>
          <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="22"><StackPanel><TextBlock Text="执行状态" Foreground="{StaticResource MutedBrush}" FontSize="13"/><TextBlock x:Name="StatusText" Text="就绪" FontSize="26" FontWeight="SemiBold" Margin="0,14,0,0"/><TextBlock Text="等待选择软件包" Foreground="{StaticResource MutedBrush}" FontSize="12"/></StackPanel></Border>
        </Grid>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="22" Margin="0,18,0,0">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0"><TextBlock Text="软件包" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="选择一个软件包开始部署" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
              <Button Grid.Column="1" Content="应用选中包" Click="Apply_Click"/>
            </Grid>
            <TextBox x:Name="SearchBox" PlaceholderText="搜索软件包..." Margin="0,16,0,8" TextChanged="SearchBox_TextChanged"/>
            <ListBox x:Name="PackageList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" MinHeight="150">
              <ListBox.ItemTemplate><DataTemplate><Border Padding="10,8" Margin="0,2" Background="#F0F4FA" CornerRadius="8"><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="22" Margin="0,18,0,0">
          <StackPanel><Grid><TextBlock Text="实时日志" FontSize="19" FontWeight="SemiBold"/><Button Content="清空" HorizontalAlignment="Right" Click="ClearLog_Click"/></Grid><TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Background="#F8FAFC" Foreground="#344054" Height="150" Margin="0,14,0,0" Padding="10"/></StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
